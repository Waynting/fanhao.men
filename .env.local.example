# Works with no env vars at all: data is stored in the browser (localStorage) per device.

# Canonical site URL for metadata, robots.txt and sitemap.xml (no trailing slash).
# Production: https://fanhao.men. Unset → Vercel production domain, or http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (Optional)
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX. Unset → analytics disabled (leave it unset locally).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (Optional) — enables login + cloud sync. Without these the app is local-only.
# Project Settings → API. Run supabase/migrations/*.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
